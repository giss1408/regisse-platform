# Copy to monitoring/.env (gitignored, chmod 600). Never commit real values.
# From Grafana Cloud > your stack > "Details": Prometheus (Mimir) and Loki endpoints, and one access-policy token with metrics:write + logs:write.
GRAFANA_PROMETHEUS_URL=https://prometheus-prod-XX.grafana.net/api/prom/push
GRAFANA_PROMETHEUS_USER=
GRAFANA_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USER=
GRAFANA_CLOUD_TOKEN=
# Same value as AUTH_METRICS_TOKEN in the auth service (and each product's own METRICS_TOKEN)
AUTH_METRICS_TOKEN=
# Same value as METRICS_TOKEN in fidelia's .env.platform
FIDELIA_METRICS_TOKEN=
# Label to tell staging from prod
HOSTNAME_LABEL=regisse-staging
# Generated by scripts/make-monitoring.sh
MONITOR_DB_PASSWORD=
MONITOR_REDIS_PASSWORD=
