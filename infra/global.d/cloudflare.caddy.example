# Behind Cloudflare, Caddy sees Cloudflare's addresses, not the visitor's. Copy this file to cloudflare.caddy (same folder) on the SERVER (not
# on a laptop) and `docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile`: Caddy then trusts Cloudflare's ranges and takes
# the real client address from CF-Connecting-IP, which is what `client_ip` matchers (the optional /admin allowlist) and the proxy headers use.
# The ranges change rarely: check https://www.cloudflare.com/ips/ before copying. With a wrong list the allowlist is spoofable or blocks everyone.
servers {
	trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	client_ip_headers CF-Connecting-IP
}
