# Copy to .env via `make init` (generates secrets). Never commit .env.

# Domain: products are served at <product>-api.<DOMAIN>
DOMAIN=localhost
# "http://" for local (no TLS), empty for production (Caddy gets real certs / Cloudflare)
SITE_SCHEME=http://
CADDY_GLOBAL_OPTS="auto_https off"
ACME_EMAIL=admin@example.com

# Local dev ports (production: 80/443)
HTTP_PORT=8080
HTTPS_PORT=8443

# Generated by `make init`
POSTGRES_PASSWORD=
REDIS_ADMIN_PASSWORD=

# Tuning (defaults suit the 4 vCPU / 8 GB production server; lower them for local dev)
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=1GB
PG_MAX_CONNECTIONS=100
PG_MEM_LIMIT=2g
REDIS_MAXMEMORY=256mb

# Backups (scripts/backup.sh)
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30
# age public key: when set, dumps are encrypted before leaving the host
AGE_RECIPIENT=
# rclone remote for Cloudflare R2, e.g. r2:regisse-backups ; empty = local only
RCLONE_REMOTE=

# Optional: URL pinged after every successful backup (dead-man's switch; alert when it stops arriving)
BACKUP_HEARTBEAT_URL=
